# Names only. Copy to .env and fill in. .env is git-ignored; never commit values.

# Database (Neon Postgres): private data only (nullifiers, clip keys, jobs, payments)
DATABASE_URL=

# Arkiv (Rabdi testnet): one signer per role
ARKIV_ACCESS_KEY=
ARKIV_NS=adx
ARKIV_PLATFORM_WEB_KEY=
ARKIV_PLATFORM_WORKER_KEY=
ARKIV_VERIFIER_KEY=
ARKIV_BUYER_KEY=
ARKIV_BUYER_ADDRESS=

# Hedera (testnet)
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_BUYER_ID=
HEDERA_BUYER_KEY=
HEDERA_MERCHANT_ID=
HEDERA_USDC_TOKEN_ID=0.0.429274
HEDERA_SPEND_TOPIC_ID=
FACILITATOR_URL=https://x402.org/facilitator

# Swarm: our own Bee node + postage batch
BEE_URL=
SWARM_BATCH_ID=

# World: IDKit (claims) + World IdP Agent Pass (approvals)
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
WORLD_ACTION=claim-task
WORLD_ENV=production
WORLD_AGENTPASS_CLIENT_ID=
WORLD_AGENTPASS_CLIENT_SECRET=
NEXT_PUBLIC_WORLD_PRESET=

# AI: Gemini watches clips; Claude writes the agent's one-line notes (never moves money)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5

# Worker
UPLOAD_TOKEN_SECRET=
WORKER_PUBLIC_URL=
WEB_ORIGIN=
CLIP_DIR=/tmp/adx-clips
PORT=8080

# Agent
AGENT_TARGET_URL=https://adx-paradigm.vercel.app
AGENT_AUTO_LIMIT=5
AGENT_HARD_CAP=10
AGENT_DAILY_BUDGET=20
AGENT_TICK_MS=5000
