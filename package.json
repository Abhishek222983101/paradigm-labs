{
  "name": "adx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "arkiv:smoke": "tsx --env-file=.env scripts/arkiv/arkiv-smoke.ts",
    "hedera:setup": "tsx --env-file=.env scripts/hedera/hedera-setup.ts",
    "x402:smoke": "tsx --env-file=.env scripts/hedera/x402-smoke.ts",
    "swarm:smoke": "tsx --env-file=.env scripts/swarm/swarm-smoke.ts",
    "swarm:fund": "tsx --env-file=.env scripts/swarm/swarm-fund.ts",
    "swarm:fund-node": "tsx --env-file=.env scripts/swarm/swarm-fund-node.ts",
    "swarm:buy-batch": "tsx --env-file=.env scripts/swarm/swarm-buy-batch.ts",
    "dev": "pnpm --filter @adx/web dev",
    "build": "pnpm --filter @adx/web build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "doctor": "tsx --env-file=.env scripts/ops/doctor.ts",
    "db:push": "pnpm --filter @adx/db exec drizzle-kit push",
    "arkiv:wallets": "tsx --env-file=.env scripts/arkiv/arkiv-wallets.ts",
    "seed:arkiv": "tsx --env-file=.env scripts/arkiv/seed-arkiv.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "arkiv:roundtrip": "tsx --env-file=.env scripts/arkiv/arkiv-roundtrip.ts",
    "hedera:alias-spike": "tsx --env-file=.env scripts/hedera/hedera-alias-spike.ts",
    "test:claims": "cd apps/web && ARKIV_NS=adx-test tsx --conditions=react-server --env-file=../../.env test/claims.int.mts",
    "test:upload": "cd apps/worker && tsx --env-file=../../.env test/upload.int.ts",
    "worker:dev": "cd apps/worker && PORT=8099 CLIP_DIR=/tmp/adx-clips tsx --env-file=../../.env src/main.ts",
    "test:record": "cd apps/web && tsx --env-file=../../.env test/record.e2e.mts",
    "test:claim-ui": "cd apps/web && tsx test/claim-ui.e2e.mts",
    "test:pipeline": "cd apps/worker && ARKIV_NS=adx-test NODE_OPTIONS=--dns-result-order=ipv4first tsx --env-file=../../.env test/pipeline.int.ts",
    "test:x402": "cd apps/web && ARKIV_NS=adx-test NODE_OPTIONS=--dns-result-order=ipv4first tsx --env-file=../../.env test/x402.int.mts",
    "hcs:topic": "tsx --env-file=.env scripts/hedera/hcs-topic.ts",
    "test:agent": "cd apps/agent && ARKIV_NS=adx-test NODE_OPTIONS=--dns-result-order=ipv4first tsx --env-file=../../.env test/agent.int.ts",
    "sponsor:check": "NODE_OPTIONS=--dns-result-order=ipv4first tsx --env-file=.env scripts/ops/sponsor-check.ts",
    "outside-agent": "tsx scripts/ops/outside-agent.ts"
  },
  "dependencies": {
    "@adx/db": "workspace:^",
    "@adx/shared": "workspace:^",
    "@arkiv-network/sdk": "1.0.1",
    "@hiero-ledger/sdk": "2.90.1",
    "@x402/core": "2.30.0",
    "@x402/express": "2.30.0",
    "@x402/fetch": "2.30.0",
    "@x402/hedera": "2.30.0",
    "express": "5",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/express": "5",
    "@types/node": "22",
    "ethers": "6",
    "playwright-core": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
